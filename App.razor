@inject IJSRuntime JS

<HeadContent>
    <title>.NET Unicode Explorer</title>
    <meta name="description" content="Inspect .NET strings as grapheme clusters, Rune values, UTF-16 code units, encoded bytes, and Unicode normalization forms in your browser." />
    <link rel="canonical" href="https://unicode.swimburger.net/" />
</HeadContent>

<a class="skip-link" href="#inspect">Skip to the explorer</a>

<header class="app-header">
    <div class="container header-content">
        <div>
            <h1 id="unicode-explorer-heading">.NET Unicode Explorer</h1>
            <p>Inspect text as grapheme clusters, Unicode scalar values, UTF-16 code units, and encoded bytes.</p>
        </div>
        <a class="source-link" href="https://github.com/Swimburger/DotNetUnicodeExplorer">Source</a>
    </div>
</header>

<main>
    <section id="inspect" class="workbench" aria-labelledby="input-heading">
        <div class="workbench-heading">
            <div>
                <h2 id="input-heading">Text to inspect</h2>
            </div>
            <label class="example-picker" for="example-picker">
                <span>Load an example</span>
                <select id="example-picker" name="example" @onchange="LoadExample">
                    @foreach (var example in Examples)
                    {
                        <option value="@example.Key" selected="@(example.Key == selectedExample)">@example.Label</option>
                    }
                </select>
            </label>
        </div>

        <div class="session-toolbar" aria-label="Session tools">
            <button type="button" @onclick="CopyShareLink">Copy link</button>
            <button type="button" @onclick="CopyResult" disabled="@(analysis.Value.Length == 0)">Copy result</button>
            <button type="button" @onclick="Reset">Reset</button>
            <label class="remember-choice"><input type="checkbox" checked="@rememberOnDevice" @onchange="RememberChanged" /> Remember on this device</label>
            <button type="button" class="forget-button" @onclick="ForgetSavedWork" disabled="@(!rememberOnDevice)">Forget saved work</button>
            <span class="shortcut-hint"><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Enter</kbd> analyzes</span>
        </div>

        <form class="input-form" aria-labelledby="input-heading" @onsubmit="AnalyzeSubmitted">
            <fieldset class="mode-picker">
                <legend>Input mode</legend>
                <label><input type="radio" name="input-mode" value="text" checked="@(!escapedMode)" @onchange="UseTextMode" /> Text</label>
                <label><input type="radio" name="input-mode" value="escaped" checked="@escapedMode" @onchange="UseEscapedMode" /> C# escapes</label>
            </fieldset>
            <div class="input-field">
                <label for="string-input">@(escapedMode ? "C# escaped string contents" : "Text to inspect")</label>
                <span id="input-hint" class="hint">@(escapedMode ? @"Enter contents such as e\u0301 or \U0001F970, without surrounding quotes." : "Paste or type any text.")</span>
                <textarea id="string-input" name="input" rows="5" spellcheck="false" autocorrect="off" autocapitalize="none"
                          aria-describedby="@(showError ? "input-hint input-error" : "input-hint")"
                          aria-invalid="@(showError ? "true" : "false")"
                          maxlength="4096" value="@input" @oninput="InputChanged" @onblur="InputBlurred"></textarea>
                @if (showError)
                {
                    <p id="input-error" class="validation-error"><strong>Error:</strong> @parseError</p>
                }
            </div>
            <div class="input-actions">
                <button type="submit" class="primary">Analyze string</button>
                <button type="button" @onclick="CopyEscaped" disabled="@(analysis.Value.Length == 0)">Copy escaped C#</button>
            </div>
        </form>

        <p class="copy-status" role="status" aria-live="polite">@copyStatus</p>

        <section class="rendered-panel" aria-labelledby="rendered-heading">
            <div>
                <h3 id="rendered-heading">Rendered text</h3>
                <p>What the browser displays. Whitespace and invisible code points may not be apparent here.</p>
            </div>
            <pre tabindex="0" role="region" aria-labelledby="rendered-heading"><code>@if (analysis.Value.Length == 0)
                {<text>(empty string)</text>}
                else
                {@foreach (var element in analysis.TextElements)
                    {<span class="rendered-element @(selectedElement == element.Index ? "selected-text" : null)">@element.Value</span>}}</code></pre>
        </section>

        <dl class="summary-grid" aria-label="String summary">
            <div><dt><code>string.Length</code></dt><dd>@analysis.Value.Length</dd><span>UTF-16 code units</span></div>
            <div><dt>Text elements</dt><dd>@analysis.TextElements.Count</dd><span>Grapheme clusters</span></div>
            <div><dt><code>Rune</code> count</dt><dd>@analysis.Runes.Count</dd><span>Scalar values</span></div>
            <div><dt>UTF-8 bytes</dt><dd>@Utf8ByteCount</dd><span>Encoded size</span></div>
            <div><dt>Well-formed UTF-16</dt><dd>@(analysis.IsWellFormedUtf16 ? "Yes" : "No")</dd><span>@(analysis.IsWellFormedUtf16 ? "Every surrogate is paired" : "Contains an unpaired surrogate")</span></div>
        </dl>

        @if (analysis.Warnings.Count > 0)
        {
            <section class="warning-panel" aria-labelledby="warnings-heading">
                <h3 id="warnings-heading">Review these code points</h3>
                <p>These are inspection hints, not a verdict that the text is malicious.</p>
                <ul>
                    @foreach (var warning in analysis.Warnings)
                    {
                        <li class="@(IsSelected(warning.Utf16Start, warning.Utf16Length) ? "selected-warning" : null)">
                            <button type="button" @onclick="() => SelectAt(warning.Utf16Start)" @onfocus="() => SelectAt(warning.Utf16Start)">@warning.Kind</button>
                            <span>@warning.Message</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (analysis.Value.Length == 0)
        {
            <p class="empty-state">Enter text or load an example to inspect its .NET representation.</p>
        }
        else
        {
            <section class="result-section" aria-labelledby="elements-heading">
                <div class="result-heading">
                    <div><h3 id="elements-heading">Text elements <span class="count">(@analysis.TextElements.Count)</span></h3><p>Grapheme clusters reported by <code>StringInfo.ParseCombiningCharacters</code>. <a href="https://learn.microsoft.com/dotnet/api/system.globalization.stringinfo.parsecombiningcharacters">API reference</a></p></div>
                </div>
                <p class="selection-summary">@SelectionSummary</p>
                <div class="element-strip" aria-label="Text element selector">
                    @foreach (var element in analysis.TextElements)
                    {
                        <button type="button" class="element-chip @(selectedElement == element.Index ? "selected" : null)"
                                aria-pressed="@(selectedElement == element.Index ? "true" : "false")" @onclick="() => SelectElement(element.Index)" @onfocus="() => SelectElement(element.Index)">
                            <span class="element-visual">@element.Value</span>
                            <span>#@element.Index</span>
                        </button>
                    }
                </div>
                <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="elements-caption">
                    <table>
                        <caption id="elements-caption">Text elements and their UTF-16 ranges</caption>
                        <thead><tr><th scope="col">Element</th><th scope="col">Rendered</th><th scope="col">Escaped</th><th scope="col">UTF-16 range</th><th scope="col">Runes</th></tr></thead>
                        <tbody>
                        @foreach (var element in analysis.TextElements)
                        {
                            <tr class="@(selectedElement == element.Index ? "selected-row" : null)">
                                <th scope="row"><button type="button" class="row-selector" aria-label="Select text element @element.Index" aria-pressed="@(selectedElement == element.Index ? "true" : "false")" @onclick="() => SelectElement(element.Index)" @onfocus="() => SelectElement(element.Index)">@element.Index<span aria-hidden="true">@(selectedElement == element.Index ? " ✓" : string.Empty)</span></button></th><td class="large-glyph">@VisibleText(element.Value)</td><td><code>@element.Escaped</code></td>
                                <td>@element.Utf16Start..@(element.Utf16Start + element.Utf16Length - 1)</td><td>@element.RuneCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="result-section" aria-labelledby="runes-heading">
                <div class="result-heading">
                    <div><h3 id="runes-heading">Unicode scalar values <span class="count">(@analysis.Runes.Count)</span></h3><p><code>Rune</code> values enumerate code points without splitting surrogate pairs. <a href="https://learn.microsoft.com/dotnet/api/system.text.rune">API reference</a></p></div>
                </div>
                <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="runes-caption">
                    <table>
                        <caption id="runes-caption">Rune values in the string</caption>
                        <thead><tr><th scope="col">Rune</th><th scope="col">Rendered</th><th scope="col">Code point</th><th scope="col">Category</th><th scope="col">UTF-16</th><th scope="col">UTF-8 bytes</th></tr></thead>
                        <tbody>
                        @foreach (var rune in analysis.Runes)
                        {
                            <tr class="@(IsSelected(rune.Utf16Start, rune.Utf16Length) ? "selected-row" : null)">
                                <th scope="row"><button type="button" class="row-selector" aria-label="Select rune @rune.Index, @rune.CodePoint" aria-pressed="@(IsSelected(rune.Utf16Start, rune.Utf16Length) ? "true" : "false")" @onclick="() => SelectAt(rune.Utf16Start)" @onfocus="() => SelectAt(rune.Utf16Start)">@rune.Index<span aria-hidden="true">@(IsSelected(rune.Utf16Start, rune.Utf16Length) ? " ✓" : string.Empty)</span></button></th><td class="large-glyph">@VisibleText(rune.Value)</td><td><code>@rune.CodePoint</code></td>
                                <td>@SplitPascalCase(rune.Category.ToString())</td><td>@rune.Utf16Start + @rune.Utf16Length</td><td><code>@rune.Utf8Hex</code></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="result-section" aria-labelledby="code-units-heading">
                <div class="result-heading">
                    <div><h3 id="code-units-heading">UTF-16 code units <span class="count">(@analysis.CodeUnits.Count)</span></h3><p>Every position addressable by a .NET <code>string</code> index or <code>char</code>. <a href="https://learn.microsoft.com/dotnet/standard/base-types/character-encoding-introduction">Encoding concepts</a></p></div>
                </div>
                <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="code-units-caption">
                    <table>
                        <caption id="code-units-caption">UTF-16 code units in the string</caption>
                        <thead><tr><th scope="col">Index</th><th scope="col">Display</th><th scope="col">Escaped</th><th scope="col">Value</th><th scope="col">Kind</th></tr></thead>
                        <tbody>
                        @foreach (var unit in analysis.CodeUnits)
                        {
                            <tr class="@(IsSelected(unit.Index, 1) ? "selected-row" : null)">
                                <th scope="row"><button type="button" class="row-selector" aria-label="Select UTF-16 code unit @unit.Index" aria-pressed="@(IsSelected(unit.Index, 1) ? "true" : "false")" @onclick="() => SelectAt(unit.Index)" @onfocus="() => SelectAt(unit.Index)">@unit.Index<span aria-hidden="true">@(IsSelected(unit.Index, 1) ? " ✓" : string.Empty)</span></button></th><td class="large-glyph">@unit.Display</td><td><code>@unit.Escaped</code></td><td><code>@unit.Hex</code></td><td>@unit.Kind</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>

            <details class="utility-details result-section">
                <summary id="encoding-heading">Encoded bytes</summary>
                <div class="result-heading">
                    <p>The same .NET string encoded without a byte-order mark.</p>
                </div>
                <div class="encoding-grid">
                    @foreach (var encoding in analysis.Encodings)
                    {
                        <article class="encoding-card">
                            <div><h4>@encoding.Name</h4><span>@encoding.ByteCount bytes</span></div>
                            <div class="byte-strip" aria-label="@encoding.Name byte selector">
                                @foreach (var value in encoding.Bytes)
                                {
                                    <button type="button" class="byte-chip @(IsSelected(value.Utf16Start, value.Utf16Length) ? "selected" : null)"
                                            aria-label="Select @encoding.Name byte @value.Index, hexadecimal @value.Hex"
                                            aria-pressed="@(IsSelected(value.Utf16Start, value.Utf16Length) ? "true" : "false")"
                                            @onclick="() => SelectAt(value.Utf16Start)" @onfocus="() => SelectAt(value.Utf16Start)">@value.Hex</button>
                                }
                            </div>
                            <button type="button" @onclick="() => CopyEncoding(encoding)">Copy <span class="visually-hidden">@encoding.Name bytes</span></button>
                        </article>
                    }
                </div>
            </details>
        }
    </section>

    <details id="normalize" class="page-section utility-details">
        <summary id="normalization-heading">Unicode normalization</summary>
        <div class="section-heading">
            <p>Compare all four <code>string.Normalize</code> forms and see their platform status. “Changed” means the result differs ordinally from the input.</p>
        </div>
        <div class="normalization-grid">
            @foreach (var form in analysis.Normalizations)
            {
                <article class="normalization-card">
                    <header><div><h3>@form.ShortName</h3><p>@form.Name</p></div><span class="change-badge @(!form.Supported || form.Changed ? "changed" : null)">@(!form.Supported ? "Unavailable" : form.Changed ? "Changed" : "Unchanged")</span></header>
                    @if (form.Supported)
                    {
                        <pre tabindex="0" role="region" aria-label="@form.ShortName normalized value"><code>@(form.Value.Length == 0 ? "(empty string)" : form.Value)</code></pre>
                        <dl><div><dt>Escaped</dt><dd><code>@form.Escaped</code></dd></div><div><dt>UTF-16</dt><dd>@form.Utf16Length</dd></div><div><dt>Runes</dt><dd>@form.RuneCount</dd></div><div><dt>UTF-8</dt><dd>@form.Utf8ByteCount bytes</dd></div></dl>
                    }
                    else
                    {
                        <p class="unsupported-note"><strong>Not available in this .NET runtime.</strong> @form.Note</p>
                    }
                    <button type="button" @onclick="() => CopyNormalization(form)" disabled="@(!form.Supported)">Copy escaped value</button>
                </article>
            }
        </div>
    </details>

    <details class="page-section utility-details code-section">
        <summary id="code-heading">Equivalent C#</summary>
        <div class="code-block">
            <button type="button" class="code-copy" @onclick="CopyCode">Copy C#</button>
            <pre tabindex="0" role="region" aria-labelledby="code-heading"><code>@CodeSnippet</code></pre>
        </div>
    </details>

    <details id="reference" class="page-section utility-details reference-section">
        <summary id="reference-heading">.NET Unicode quick reference</summary>
        <div class="section-heading"><p>A displayed “character” can mean several different units. Choose the API that matches the job.</p></div>
        <div class="table-wrapper reference-table" tabindex="0" role="region" aria-labelledby="reference-caption">
            <table>
                <caption id="reference-caption">.NET string and Unicode abstractions</caption>
                <thead><tr><th scope="col">Concept</th><th scope="col">.NET API</th><th scope="col">What it represents</th><th scope="col">Use it for</th></tr></thead>
                <tbody>
                    <tr><th scope="row">UTF-16 code unit</th><td><code>char</code>, <code>string.Length</code></td><td>One 16-bit value</td><td>Index compatibility and low-level UTF-16 work</td></tr>
                    <tr><th scope="row">Unicode scalar value</th><td><code>Rune</code>, <code>EnumerateRunes()</code></td><td>One valid Unicode code point</td><td>Character classification and code-point processing</td></tr>
                    <tr><th scope="row">Text element</th><td><code>StringInfo</code></td><td>One extended grapheme cluster</td><td>User-perceived characters, cursor movement, and truncation</td></tr>
                    <tr><th scope="row">Encoded bytes</th><td><code>Encoding.UTF8</code> and related APIs</td><td>A serialized byte sequence</td><td>Files, protocols, storage, and byte limits</td></tr>
                    <tr><th scope="row">Normalized string</th><td><code>string.Normalize()</code></td><td>A canonical or compatibility representation</td><td>Consistent representation before an appropriate comparison</td></tr>
                </tbody>
            </table>
        </div>
        <div class="docs-links">
            <a href="https://learn.microsoft.com/dotnet/standard/base-types/character-encoding-introduction">Character encoding in .NET</a>
            <a href="https://learn.microsoft.com/dotnet/api/system.text.rune">Rune API reference</a>
            <a href="https://learn.microsoft.com/dotnet/api/system.globalization.stringinfo">StringInfo API reference</a>
            <a href="https://learn.microsoft.com/dotnet/api/system.string.normalize">String.Normalize API reference</a>
        </div>
    </details>
</main>

<footer class="site-footer">
    <div>
        <p>Runs locally in your browser with .NET WebAssembly.</p>
        <nav aria-label="Footer"><a href="https://swimburger.net/privacy">Privacy policy</a><a href="https://github.com/Swimburger/DotNetUnicodeExplorer">Source code</a><a href="https://swimburger.net/">swimburger.net</a></nav>
        <small>Unicode segmentation and normalization results can vary with the Unicode and ICU data used by the runtime. .NET browser targets don't support compatibility normalization (NFKC/NFKD); the explorer reports that platform limitation. Formal Unicode character names are intentionally not included.</small>
    </div>
</footer>

<div id="blazor-error-ui" role="alert">
    An unexpected error occurred. <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error message">×</button>
</div>

@code {
    private sealed record Example(string Key, string Label, string Value, bool Escaped = false);
    private sealed record StoredState(int Version, string Input, bool EscapedMode, string SelectedExample);

    private static readonly Example[] Examples =
    [
        new("accent", "Composed and combining accents", @"Café | Cafe\u0301", true),
        new("emoji", "Emoji surrogate pair", "A🥰B"),
        new("family", "Family emoji (ZWJ sequence)", "👨‍👩‍👧‍👦"),
        new("flag", "Belgian flag", "🇧🇪"),
        new("skin-tone", "Emoji with skin tone", "👍🏽"),
        new("devanagari", "Devanagari conjunct", "नमस्ते"),
        new("compatibility", "Compatibility forms", "① Ⅳ ﬁ Ａ"),
        new("whitespace", "Whitespace and controls", @"first\tsecond\nthird", true),
        new("invisible", "Invisible zero-width characters", @"user\u200Bname\u2060", true),
        new("bidi", "Bidirectional override in a filename", @"invoice\u202Ecod.exe", true),
        new("confusable", "Mixed-script confusable letters", "paypal | раypal"),
        new("invalid", "Unpaired UTF-16 surrogate", @"before\uD800after", true)
    ];

    private string input = Examples[0].Value;
    private bool escapedMode = Examples[0].Escaped;
    private string selectedExample = Examples[0].Key;
    private string? parseError;
    private bool hasBlurred;
    private bool submitted;
    private string copyStatus = string.Empty;
    private int selectedElement;
    private bool rememberOnDevice;
    private bool browserInitialized;
    private UnicodeAnalysis analysis = UnicodeAnalyzer.Analyze("Café | Cafe\u0301");

    private bool showError => parseError is not null && (hasBlurred || submitted);
    private int Utf8ByteCount => analysis.Encodings.FirstOrDefault(item => item.Name == "UTF-8")?.ByteCount ?? 0;
    private TextElementInfo? SelectedTextElement => analysis.TextElements.ElementAtOrDefault(selectedElement);
    private string SelectionSummary => SelectedTextElement is { } selected
        ? $"Selected text element {selected.Index}: UTF-16 {selected.Utf16Start}..{selected.Utf16Start + selected.Utf16Length - 1}, {selected.RuneCount} rune{(selected.RuneCount == 1 ? string.Empty : "s")}. Related rows and bytes are highlighted."
        : "No text element selected.";
    private string CodeSnippet => $$"""
        using System.Globalization;
        using System.Text;

        string value = "{{analysis.Escaped}}";

        int utf16CodeUnits = value.Length;
        int scalarValues = 0;
        foreach (Rune _ in value.EnumerateRunes()) scalarValues++;
        int textElements = StringInfo.ParseCombiningCharacters(value).Length;
        byte[] utf8 = Encoding.UTF8.GetBytes(value);

        string nfc = value.Normalize(NormalizationForm.FormC);
        string nfd = value.Normalize(NormalizationForm.FormD);
        """;

    protected override void OnInitialized() => Reanalyze();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || browserInitialized) return;
        browserInitialized = true;
        await SafeInvokeVoid("unicodeUi.attachAnalyzeShortcut", "string-input");
        var shared = await SafeInvokeString("unicodeUi.readSharedState");
        if (!TryRestoreState(shared))
        {
            var stored = await SafeInvokeString("unicodeUi.readStoredState");
            if (TryRestoreState(stored)) rememberOnDevice = true;
        }
        StateHasChanged();
    }

    private void InputChanged(ChangeEventArgs args)
    {
        input = args.Value?.ToString() ?? string.Empty;
        selectedExample = string.Empty;
        submitted = false;
        Reanalyze();
    }

    private async Task InputBlurred()
    {
        hasBlurred = true;
        await SaveIfRemembered();
    }

    private async Task AnalyzeSubmitted()
    {
        submitted = true;
        hasBlurred = true;
        Reanalyze();
        await SaveIfRemembered();
    }

    private async Task UseTextMode()
    {
        escapedMode = false;
        input = analysis.Value;
        ResetInteraction();
        Reanalyze();
        await SaveIfRemembered();
    }

    private async Task UseEscapedMode()
    {
        escapedMode = true;
        input = analysis.Escaped;
        ResetInteraction();
        Reanalyze();
        await SaveIfRemembered();
    }

    private async Task LoadExample(ChangeEventArgs args)
    {
        var key = args.Value?.ToString() ?? Examples[0].Key;
        var example = Examples.First(item => item.Key == key);
        selectedExample = example.Key;
        input = example.Value;
        escapedMode = example.Escaped;
        ResetInteraction();
        Reanalyze();
        await SaveIfRemembered();
    }

    private async Task Reset()
    {
        input = Examples[0].Value;
        escapedMode = Examples[0].Escaped;
        selectedExample = Examples[0].Key;
        ResetInteraction();
        Reanalyze();
        await SafeInvokeVoid("unicodeUi.clearShareState");
        await SaveIfRemembered();
    }

    private void ResetInteraction()
    {
        hasBlurred = false;
        submitted = false;
        copyStatus = string.Empty;
        selectedElement = 0;
    }

    private void Reanalyze()
    {
        var result = escapedMode ? UnicodeAnalyzer.ParseEscaped(input) : ParseResult.Ok(input);
        parseError = result.Error;
        if (result.Success)
        {
            analysis = UnicodeAnalyzer.Analyze(result.Value);
            if (selectedElement >= analysis.TextElements.Count) selectedElement = 0;
        }
    }

    private void SelectElement(int index) => selectedElement = index;

    private void SelectAt(int utf16Start)
    {
        var match = analysis.TextElements.FirstOrDefault(item =>
            utf16Start >= item.Utf16Start && utf16Start < item.Utf16Start + item.Utf16Length);
        if (match is not null) selectedElement = match.Index;
    }

    private bool IsSelected(int start, int length)
    {
        var selected = SelectedTextElement;
        if (selected is null) return false;
        var end = start + length;
        var selectedEnd = selected.Utf16Start + selected.Utf16Length;
        return start < selectedEnd && end > selected.Utf16Start;
    }

    private async Task CopyEscaped() => await Copy($"\"{analysis.Escaped}\"", "escaped C# string");
    private async Task CopyEncoding(DotNetUnicodeExplorer.Core.EncodingInfo encoding) => await Copy(encoding.Hex, $"{encoding.Name} bytes");
    private async Task CopyNormalization(NormalizationInfo form) => await Copy(form.Escaped, $"{form.ShortName} escaped value");
    private async Task CopyCode() => await Copy(CodeSnippet, "C# example");
    private async Task CopyResult() => await Copy(AnalysisText, "analysis result");

    private async Task CopyShareLink()
    {
        var result = await SafeInvokeString("unicodeUi.copyShareLink", StateJson) ?? "failed";
        copyStatus = result switch
        {
            "copied" => "Copied a private-by-default share link. Its state is stored after the # fragment.",
            "too-long" => "This input is too large for a reliable share link. Shorten it and try again.",
            _ => "Copy failed. Your browser may have denied clipboard access."
        };
    }

    private async Task RememberChanged(ChangeEventArgs args)
    {
        rememberOnDevice = args.Value is true;
        if (rememberOnDevice)
        {
            await SafeInvokeVoid("unicodeUi.writeStoredState", StateJson);
            copyStatus = "This input will be remembered only in this browser. Avoid saving secrets.";
        }
        else
        {
            await SafeInvokeVoid("unicodeUi.forgetStoredState");
            copyStatus = "Saved work removed from this browser.";
        }
    }

    private async Task ForgetSavedWork()
    {
        rememberOnDevice = false;
        await SafeInvokeVoid("unicodeUi.forgetStoredState");
        copyStatus = "Saved work removed from this browser.";
    }

    private async Task SaveIfRemembered()
    {
        if (rememberOnDevice) await SafeInvokeVoid("unicodeUi.writeStoredState", StateJson);
    }

    private string StateJson => System.Text.Json.JsonSerializer.Serialize(new StoredState(1, input, escapedMode, selectedExample));

    private bool TryRestoreState(string? json)
    {
        if (string.IsNullOrWhiteSpace(json) || json.Length > 12_000) return false;
        try
        {
            var state = System.Text.Json.JsonSerializer.Deserialize<StoredState>(json);
            if (state is null || state.Version != 1 || state.Input is null || state.Input.Length > 4096) return false;
            input = state.Input;
            escapedMode = state.EscapedMode;
            selectedExample = Examples.Any(item => item.Key == state.SelectedExample) ? state.SelectedExample : string.Empty;
            ResetInteraction();
            Reanalyze();
            return true;
        }
        catch (System.Text.Json.JsonException)
        {
            return false;
        }
    }

    private string AnalysisText
    {
        get
        {
            var lines = new List<string>
            {
                $"Value: \"{analysis.Escaped}\"",
                $"UTF-16 code units: {analysis.Value.Length}",
                $"Text elements: {analysis.TextElements.Count}",
                $"Runes: {analysis.Runes.Count}",
                $"UTF-8 bytes: {Utf8ByteCount}",
                $"Well-formed UTF-16: {(analysis.IsWellFormedUtf16 ? "Yes" : "No")}"
            };
            lines.AddRange(analysis.Runes.Select(item => $"Rune {item.Index}: {item.CodePoint}, {SplitPascalCase(item.Category.ToString())}, UTF-16 {item.Utf16Start}+{item.Utf16Length}, UTF-8 {item.Utf8Hex}"));
            lines.AddRange(analysis.Warnings.Select(item => $"Warning — {item.Kind}: {item.Message}"));
            return string.Join(Environment.NewLine, lines);
        }
    }

    private async Task Copy(string text, string label)
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("unicodeUi.copyText", text);
            copyStatus = copied ? $"Copied {label}." : $"Copy failed for {label}. Select the value and copy it manually.";
        }
        catch (JSException)
        {
            copyStatus = $"Copy failed for {label}. Select the value and copy it manually.";
        }
    }

    private static string SplitPascalCase(string value) => string.Concat(value.Select((character, index) => index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));

    private static string VisibleText(string value)
    {
        if (value.Length == 0) return "∅";
        var runes = value.EnumerateRunes().ToArray();
        if (runes.All(rune => Rune.GetUnicodeCategory(rune) is UnicodeCategory.Control or UnicodeCategory.Format))
            return $"⟦{string.Join(", ", runes.Select(rune => UnicodeAnalyzer.InvisibleName(rune.Value)))}⟧";
        return value;
    }

    private async Task SafeInvokeVoid(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (JSException)
        {
            copyStatus = "Browser storage or clipboard access is unavailable.";
        }
    }

    private async Task<string?> SafeInvokeString(string identifier, params object?[] args)
    {
        try
        {
            return await JS.InvokeAsync<string?>(identifier, args);
        }
        catch (JSException)
        {
            return null;
        }
    }
}
